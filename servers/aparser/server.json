{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.antohins/seo-tools-mcp-aparser",
  "title": "SEO Tools: A-Parser bridge",
  "description": "Drive a self-hosted A-Parser instance: SERP, suggests and hundreds of parsers via its API (read-only).",
  "repository": {
    "url": "https://github.com/antohins/seo-tools-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/antohins/seo-tools-mcp#readme",
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "seo-tools-mcp-aparser",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APARSER_URL",
          "description": "A-Parser API endpoint, e.g. http://IP:9091/API (Settings -> API).",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "APARSER_PASSWORD",
          "description": "A-Parser API password (Settings -> API).",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
